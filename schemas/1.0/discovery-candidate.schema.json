{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:research-kb:schema:1.0:discovery-candidate",
  "$defs": {
    "result_key": {
      "type": "string",
      "maxLength": 1024,
      "pattern": "^(?:doi:10\\.\\d{4,9}/\\S+|europe-pmc:[a-z0-9._-]+:[A-Za-z0-9._-]+(?::[2-9][0-9]*)?)$"
    },
    "query": {
      "type": "object",
      "additionalProperties": false,
      "required": ["date_from", "date_until", "title_keywords", "abstract_keywords", "keyword_mode", "include_preprints", "max_results"],
      "properties": {
        "date_from": {"type": "string", "format": "date"},
        "date_until": {"type": "string", "format": "date"},
        "title_keywords": {
          "type": "array",
          "maxItems": 20,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 128}
        },
        "abstract_keywords": {
          "type": "array",
          "maxItems": 20,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 128}
        },
        "keyword_mode": {"enum": ["any", "all"]},
        "include_preprints": {"type": "boolean"},
        "max_results": {"type": "integer", "minimum": 1, "maximum": 15}
      }
    },
    "discovery_source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "source", "record_id"],
      "properties": {
        "provider": {"const": "europe-pmc"},
        "source": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,128}$"},
        "record_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,128}$"}
      }
    },
    "selection_context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["selection_context_id", "provider", "provider_api_version", "query", "report_sha256", "target_question_ids", "selected_at"],
      "properties": {
        "selection_context_id": {"type": "string", "pattern": "^selection_sha256_[0-9a-f]{64}$"},
        "provider": {"const": "europe-pmc"},
        "provider_api_version": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,64}$"},
        "query": {"$ref": "#/$defs/query"},
        "report_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "target_question_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "urn:research-kb:schema:1.0:definitions#/$defs/question_id"}
        },
        "selected_at": {"$ref": "urn:research-kb:schema:1.0:definitions#/$defs/timestamp"}
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "candidate_id",
    "workspace_id",
    "domain_profile_id",
    "result_key",
    "title",
    "authors",
    "first_publication_date",
    "journal_or_server",
    "doi",
    "paper_type",
    "publication_types",
    "abstract",
    "matched_keywords",
    "match_location",
    "discovery_sources",
    "full_text_status",
    "version_relationship",
    "possible_duplicate_result_keys",
    "selection_contexts",
    "target_question_ids",
    "selection_status",
    "source_status",
    "acquisition_status",
    "not_evidence",
    "automation_status",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "schema_version": {"$ref": "urn:research-kb:schema:1.0:definitions#/$defs/schema_version"},
    "candidate_id": {"$ref": "urn:research-kb:schema:1.0:definitions#/$defs/discovery_id"},
    "workspace_id": {"$ref": "urn:research-kb:schema:1.0:definitions#/$defs/workspace_id"},
    "domain_profile_id": {"$ref": "urn:research-kb:schema:1.0:definitions#/$defs/slug"},
    "result_key": {"$ref": "#/$defs/result_key"},
    "title": {"type": "string", "minLength": 1, "maxLength": 2000},
    "authors": {"type": "array", "maxItems": 500, "items": {"type": "string", "minLength": 1, "maxLength": 512}},
    "first_publication_date": {"type": "string", "format": "date"},
    "journal_or_server": {"type": ["string", "null"], "minLength": 1, "maxLength": 1000},
    "doi": {"type": ["string", "null"], "maxLength": 512, "pattern": "^10\\.\\d{4,9}/\\S+$"},
    "paper_type": {"enum": ["preprint", "review", "article", "other"]},
    "publication_types": {"type": "array", "maxItems": 100, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 256}},
    "abstract": {"type": ["string", "null"], "minLength": 1, "maxLength": 50000},
    "matched_keywords": {"type": "array", "minItems": 1, "maxItems": 40, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 128}},
    "match_location": {"enum": ["title", "abstract", "both"]},
    "discovery_sources": {"type": "array", "minItems": 1, "maxItems": 1000, "uniqueItems": true, "items": {"$ref": "#/$defs/discovery_source"}},
    "full_text_status": {"enum": ["open_access", "free_to_read", "subscription_required", "unavailable", "unknown"]},
    "version_relationship": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "related_doi"],
      "properties": {"status": {"const": "unresolved"}, "related_doi": {"type": "null"}}
    },
    "possible_duplicate_result_keys": {"type": "array", "maxItems": 14, "uniqueItems": true, "items": {"$ref": "#/$defs/result_key"}},
    "selection_contexts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/selection_context"}},
    "target_question_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "urn:research-kb:schema:1.0:definitions#/$defs/question_id"}},
    "selection_status": {"const": "user_selected"},
    "source_status": {"const": "metadata_only"},
    "acquisition_status": {"const": "not_started"},
    "not_evidence": {"const": true},
    "automation_status": {"const": "passed_auto_checks"},
    "created_at": {"$ref": "urn:research-kb:schema:1.0:definitions#/$defs/timestamp"},
    "updated_at": {"$ref": "urn:research-kb:schema:1.0:definitions#/$defs/timestamp"},
    "fixture_origin": {"$ref": "urn:research-kb:schema:1.0:definitions#/$defs/fixture_origin"}
  }
}
