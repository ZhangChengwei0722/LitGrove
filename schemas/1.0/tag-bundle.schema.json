{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:research-kb:schema:1.0:tag-bundle",
  "$defs": {
    "approval": {"type": "object", "additionalProperties": false, "required": ["receipt_id", "approved_by", "approved_at", "origin"], "properties": {"receipt_id": {"type": "string", "minLength": 1}, "approved_by": {"const": "user"}, "approved_at": {"$ref": "urn:research-kb:schema:1.0:definitions#/$defs/timestamp"}, "origin": {"const": "user_authored"}}},
    "tag": {"type": "object", "additionalProperties": false, "required": ["schema_version", "tag_id", "name", "normalized_name", "description", "aliases", "status"], "properties": {"schema_version": {"$ref": "urn:research-kb:schema:1.0:definitions#/$defs/schema_version"}, "tag_id": {"$ref": "urn:research-kb:schema:1.0:definitions#/$defs/tag_id"}, "name": {"type": "string", "minLength": 1, "maxLength": 80}, "normalized_name": {"type": "string", "minLength": 1, "maxLength": 80}, "description": {"type": "string", "maxLength": 500}, "aliases": {"type": "array", "maxItems": 25, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 80}}, "status": {"enum": ["active", "archived"]}}},
    "predecessor": {"oneOf": [{"type": "null"}, {"type": "object", "additionalProperties": false, "required": ["revision_id", "revision_digest"], "properties": {"revision_id": {"$ref": "urn:research-kb:schema:1.0:definitions#/$defs/tag_revision_id"}, "revision_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}]},
    "revision": {"type": "object", "additionalProperties": false, "required": ["revision_id", "revision_number", "predecessor", "content_digest", "approval", "tag", "created_at"], "properties": {"revision_id": {"$ref": "urn:research-kb:schema:1.0:definitions#/$defs/tag_revision_id"}, "revision_number": {"type": "integer", "minimum": 1}, "predecessor": {"$ref": "#/$defs/predecessor"}, "content_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "approval": {"$ref": "#/$defs/approval"}, "tag": {"$ref": "#/$defs/tag"}, "created_at": {"$ref": "urn:research-kb:schema:1.0:definitions#/$defs/timestamp"}}}
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "tag_id", "active_revision_id", "revisions", "created_at", "updated_at"],
  "properties": {"schema_version": {"$ref": "urn:research-kb:schema:1.0:definitions#/$defs/schema_version"}, "tag_id": {"$ref": "urn:research-kb:schema:1.0:definitions#/$defs/tag_id"}, "active_revision_id": {"$ref": "urn:research-kb:schema:1.0:definitions#/$defs/tag_revision_id"}, "revisions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/revision"}}, "created_at": {"$ref": "urn:research-kb:schema:1.0:definitions#/$defs/timestamp"}, "updated_at": {"$ref": "urn:research-kb:schema:1.0:definitions#/$defs/timestamp"}, "fixture_origin": {"$ref": "urn:research-kb:schema:1.0:definitions#/$defs/fixture_origin"}}
}
