{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:research-kb:schema:1.0:agent-task-state",
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "predecessor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state_id", "state_digest"],
      "properties": {
        "state_id": {"$ref": "urn:research-kb:schema:1.0:definitions#/$defs/agent_task_state_id"},
        "state_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "route_input_basis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["paper_id", "paper_record_digest", "job_id", "job_state_id", "job_state_digest", "source_digest", "parse_run_id", "parse_output_digest", "adequacy_profile_id", "adequacy_profile_digest", "requested_operation"],
      "properties": {
        "paper_id": {"$ref": "urn:research-kb:schema:1.0:definitions#/$defs/paper_id"},
        "paper_record_digest": {"$ref": "#/$defs/digest"},
        "job_id": {"$ref": "urn:research-kb:schema:1.0:definitions#/$defs/job_id"},
        "job_state_id": {"$ref": "urn:research-kb:schema:1.0:definitions#/$defs/job_state_id"},
        "job_state_digest": {"$ref": "#/$defs/digest"},
        "source_digest": {"$ref": "#/$defs/digest"},
        "parse_run_id": {"$ref": "urn:research-kb:schema:1.0:definitions#/$defs/event_id"},
        "parse_output_digest": {"$ref": "#/$defs/digest"},
        "adequacy_profile_id": {"$ref": "urn:research-kb:schema:1.0:definitions#/$defs/source_adequacy_id"},
        "adequacy_profile_digest": {"$ref": "#/$defs/digest"},
        "requested_operation": {"enum": ["basic_paper_card", "basic_review_memory"]}
      }
    },
    "primary_input_basis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["paper_id", "paper_record_digest", "origin_job_id", "job_id", "job_state_id", "job_state_digest", "source_digest", "parse_run_id", "parse_output_digest", "adequacy_profiles", "bundle_head_digest"],
      "properties": {
        "paper_id": {"$ref": "urn:research-kb:schema:1.0:definitions#/$defs/paper_id"},
        "paper_record_digest": {"$ref": "#/$defs/digest"},
        "origin_job_id": {"$ref": "urn:research-kb:schema:1.0:definitions#/$defs/job_id"},
        "job_id": {"$ref": "urn:research-kb:schema:1.0:definitions#/$defs/job_id"},
        "job_state_id": {"$ref": "urn:research-kb:schema:1.0:definitions#/$defs/job_state_id"},
        "job_state_digest": {"$ref": "#/$defs/digest"},
        "source_digest": {"$ref": "#/$defs/digest"},
        "parse_run_id": {"$ref": "urn:research-kb:schema:1.0:definitions#/$defs/event_id"},
        "parse_output_digest": {"$ref": "#/$defs/digest"},
        "adequacy_profiles": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["requested_operation", "profile_id", "profile_digest", "capability_status"],
            "properties": {
              "requested_operation": {"enum": ["basic_paper_card", "continuous_text_evidence", "figure_table_evidence", "formula_layout_analysis", "supplementary_analysis"]},
              "profile_id": {"$ref": "urn:research-kb:schema:1.0:definitions#/$defs/source_adequacy_id"},
              "profile_digest": {"$ref": "#/$defs/digest"},
              "capability_status": {"enum": ["yes", "no", "uncertain"]}
            }
          }
        },
        "bundle_head_digest": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "review_input_basis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["paper_id", "paper_record_digest", "origin_job_id", "job_id", "job_state_id", "job_state_digest", "source_digest", "parse_run_id", "parse_output_digest", "adequacy_profiles", "bundle_head_digest"],
      "properties": {
        "paper_id": {"$ref": "urn:research-kb:schema:1.0:definitions#/$defs/paper_id"},
        "paper_record_digest": {"$ref": "#/$defs/digest"},
        "origin_job_id": {"$ref": "urn:research-kb:schema:1.0:definitions#/$defs/job_id"},
        "job_id": {"$ref": "urn:research-kb:schema:1.0:definitions#/$defs/job_id"},
        "job_state_id": {"$ref": "urn:research-kb:schema:1.0:definitions#/$defs/job_state_id"},
        "job_state_digest": {"$ref": "#/$defs/digest"},
        "source_digest": {"$ref": "#/$defs/digest"},
        "parse_run_id": {"$ref": "urn:research-kb:schema:1.0:definitions#/$defs/event_id"},
        "parse_output_digest": {"$ref": "#/$defs/digest"},
        "adequacy_profiles": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["requested_operation", "profile_id", "profile_digest", "capability_status"],
            "properties": {
              "requested_operation": {"enum": ["basic_review_memory", "continuous_text_evidence", "figure_table_evidence", "formula_layout_analysis", "supplementary_analysis"]},
              "profile_id": {"$ref": "urn:research-kb:schema:1.0:definitions#/$defs/source_adequacy_id"},
              "profile_digest": {"$ref": "#/$defs/digest"},
              "capability_status": {"enum": ["yes", "no", "uncertain"]}
            }
          }
        },
        "bundle_head_digest": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "knowledge_query_input_basis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["query_type", "query_text", "paper_ids", "include_review_background", "include_routing_context", "paper_snapshots", "mapping_snapshots", "payload_digest"],
      "properties": {
        "query_type": {"enum": ["single_paper_explanation", "seven_section_overview", "methods", "selected_paper_comparison", "trend_problem_discussion", "evidence_find"]},
        "query_text": {"type": "string", "minLength": 1, "maxLength": 2000},
        "paper_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {"$ref": "urn:research-kb:schema:1.0:definitions#/$defs/paper_id"}
        },
        "include_review_background": {"type": "boolean"},
        "include_routing_context": {"type": "boolean"},
        "paper_snapshots": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["paper_id", "paper_record_digest", "canonical_paper_id", "library_status", "identity_projection_digest", "source_state", "source_digest", "document_route", "authority_mode", "revision_id", "revision_digest", "card_digest", "evidence_digests", "review_memory_digest"],
            "properties": {
              "paper_id": {"$ref": "urn:research-kb:schema:1.0:definitions#/$defs/paper_id"},
              "paper_record_digest": {"$ref": "#/$defs/digest"},
              "canonical_paper_id": {"$ref": "urn:research-kb:schema:1.0:definitions#/$defs/paper_id"},
              "library_status": {"enum": ["active", "archived", "tombstoned"]},
              "identity_projection_digest": {"$ref": "#/$defs/digest"},
              "source_state": {"enum": ["current", "stale_source", "fingerprint_mismatch", "missing", "inaccessible", "relink_required", "not_regular_file"]},
              "source_digest": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
              "document_route": {"enum": ["primary", "review", "unprocessed"]},
              "authority_mode": {"enum": ["revisioned_bundle", "legacy_unversioned", "none"]},
              "revision_id": {"type": ["string", "null"], "pattern": "^(primaryrev|reviewrev)_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
              "revision_digest": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
              "card_digest": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
              "evidence_digests": {
                "type": "array",
                "maxItems": 512,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["evidence_id", "evidence_digest"],
                  "properties": {
                    "evidence_id": {"$ref": "urn:research-kb:schema:1.0:definitions#/$defs/evidence_id"},
                    "evidence_digest": {"$ref": "#/$defs/digest"}
                  }
                }
              },
              "review_memory_digest": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}
            }
          }
        },
        "mapping_snapshots": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["question_id", "mapping_digest", "freshness"],
            "properties": {
              "question_id": {"$ref": "urn:research-kb:schema:1.0:definitions#/$defs/question_id"},
              "mapping_digest": {"$ref": "#/$defs/digest"},
              "freshness": {"enum": ["current", "stale"]}
            }
          }
        },
        "payload_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "organization_input_basis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_kind", "target_id", "proposal_goal", "paper_ids", "include_review_background", "target_snapshot", "paper_snapshots", "organization_context_digest", "payload_digest"],
      "properties": {
        "target_kind": {"enum": ["direction", "field_map_entry", "question"]},
        "target_id": {"type": ["string", "null"], "pattern": "^(direction|fieldmap|question)_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
        "proposal_goal": {"type": "string", "minLength": 1, "maxLength": 2000},
        "paper_ids": {"type": "array", "minItems": 1, "maxItems": 25, "uniqueItems": true, "items": {"$ref": "urn:research-kb:schema:1.0:definitions#/$defs/paper_id"}},
        "include_review_background": {"type": "boolean"},
        "target_snapshot": {
          "anyOf": [
            {"type": "null"},
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["target_id", "revision_id", "target_digest"],
              "properties": {
                "target_id": {"type": "string", "pattern": "^(direction|fieldmap|question)_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
                "revision_id": {"type": ["string", "null"], "pattern": "^(orgrev|questionrev)_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
                "target_digest": {"$ref": "#/$defs/digest"}
              }
            }
          ]
        },
        "paper_snapshots": {
          "type": "array",
          "minItems": 1,
          "maxItems": 25,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["paper_id", "paper_record_digest", "primary_revision_id", "primary_revision_digest", "paper_card_digest", "evidence_digests", "review_revision_id", "review_revision_digest", "review_memory_digest"],
            "properties": {
              "paper_id": {"$ref": "urn:research-kb:schema:1.0:definitions#/$defs/paper_id"},
              "paper_record_digest": {"$ref": "#/$defs/digest"},
              "primary_revision_id": {"type": ["string", "null"], "pattern": "^primaryrev_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
              "primary_revision_digest": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
              "paper_card_digest": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
              "evidence_digests": {"type": "array", "maxItems": 512, "items": {"type": "object", "additionalProperties": false, "required": ["evidence_id", "evidence_digest"], "properties": {"evidence_id": {"$ref": "urn:research-kb:schema:1.0:definitions#/$defs/evidence_id"}, "evidence_digest": {"$ref": "#/$defs/digest"}}}},
              "review_revision_id": {"type": ["string", "null"], "pattern": "^reviewrev_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
              "review_revision_digest": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
              "review_memory_digest": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}
            }
          }
        },
        "organization_context_digest": {"$ref": "#/$defs/digest"},
        "payload_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "screening_criteria_input_basis": {
      "type": "object", "additionalProperties": false,
      "required": ["question_id", "criteria_id", "proposal_goal", "question_snapshot", "criteria_snapshot", "payload_digest"],
      "properties": {
        "question_id": {"$ref": "urn:research-kb:schema:1.0:definitions#/$defs/question_id"},
        "criteria_id": {"anyOf": [{"$ref": "urn:research-kb:schema:1.0:definitions#/$defs/screening_criteria_id"}, {"type": "null"}]},
        "proposal_goal": {"type": "string", "minLength": 1, "maxLength": 2000},
        "question_snapshot": {"type": "object", "additionalProperties": false, "required": ["revision_id", "digest"], "properties": {"revision_id": {"anyOf": [{"$ref": "urn:research-kb:schema:1.0:definitions#/$defs/question_revision_id"}, {"type": "null"}]}, "digest": {"$ref": "#/$defs/digest"}}},
        "criteria_snapshot": {"anyOf": [{"type": "null"}, {"type": "object", "additionalProperties": false, "required": ["criteria_id", "revision_id", "digest"], "properties": {"criteria_id": {"$ref": "urn:research-kb:schema:1.0:definitions#/$defs/screening_criteria_id"}, "revision_id": {"$ref": "urn:research-kb:schema:1.0:definitions#/$defs/screening_criteria_revision_id"}, "digest": {"$ref": "#/$defs/digest"}}}]},
        "payload_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "screening_decision_input_basis": {
      "type": "object", "additionalProperties": false,
      "required": ["question_id", "paper_id", "basis_scope", "include_paper_card", "question_snapshot", "paper_snapshot", "criteria_snapshot", "decision_snapshot", "payload_digest"],
      "properties": {
        "question_id": {"$ref": "urn:research-kb:schema:1.0:definitions#/$defs/question_id"},
        "paper_id": {"$ref": "urn:research-kb:schema:1.0:definitions#/$defs/paper_id"},
        "basis_scope": {"enum": ["metadata", "paper_card", "mixed"]},
        "include_paper_card": {"type": "boolean"},
        "question_snapshot": {"type": "object", "additionalProperties": false, "required": ["revision_id", "digest"], "properties": {"revision_id": {"anyOf": [{"$ref": "urn:research-kb:schema:1.0:definitions#/$defs/question_revision_id"}, {"type": "null"}]}, "digest": {"$ref": "#/$defs/digest"}}},
        "paper_snapshot": {"type": "object", "additionalProperties": false, "required": ["paper_digest", "primary_revision_id", "paper_card_digest"], "properties": {"paper_digest": {"$ref": "#/$defs/digest"}, "primary_revision_id": {"anyOf": [{"$ref": "urn:research-kb:schema:1.0:definitions#/$defs/primary_revision_id"}, {"type": "null"}]}, "paper_card_digest": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}}},
        "criteria_snapshot": {"type": "object", "additionalProperties": false, "required": ["criteria_id", "revision_id", "digest"], "properties": {"criteria_id": {"$ref": "urn:research-kb:schema:1.0:definitions#/$defs/screening_criteria_id"}, "revision_id": {"$ref": "urn:research-kb:schema:1.0:definitions#/$defs/screening_criteria_revision_id"}, "digest": {"$ref": "#/$defs/digest"}}},
        "decision_snapshot": {"anyOf": [{"type": "null"}, {"type": "object", "additionalProperties": false, "required": ["decision_id", "revision_id", "digest"], "properties": {"decision_id": {"$ref": "urn:research-kb:schema:1.0:definitions#/$defs/screening_decision_id"}, "revision_id": {"$ref": "urn:research-kb:schema:1.0:definitions#/$defs/screening_decision_revision_id"}, "digest": {"$ref": "#/$defs/digest"}}}]},
        "payload_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "research_synthesis_input_basis": {
      "type": "object", "additionalProperties": false,
      "required": ["question_id", "candidate_type", "maintenance_intent", "target_candidate_id", "maintenance_goal", "include_review_background", "question_snapshot", "target_snapshot", "payload_digest"],
      "properties": {
        "question_id": {"$ref": "urn:research-kb:schema:1.0:definitions#/$defs/question_id"},
        "candidate_type": {"enum": ["synthesis", "review_angle", "insight", "cross_view"]},
        "maintenance_intent": {"enum": ["append", "replace"]},
        "target_candidate_id": {"anyOf": [{"$ref": "urn:research-kb:schema:1.0:definitions#/$defs/step7_candidate_id"}, {"type": "null"}]},
        "maintenance_goal": {"type": "string", "minLength": 1, "maxLength": 2000},
        "include_review_background": {"type": "boolean"},
        "question_snapshot": {"type": "object", "additionalProperties": false, "required": ["revision_id", "digest"], "properties": {"revision_id": {"anyOf": [{"$ref": "urn:research-kb:schema:1.0:definitions#/$defs/question_revision_id"}, {"type": "null"}]}, "digest": {"$ref": "#/$defs/digest"}}},
        "target_snapshot": {"anyOf": [{"type": "null"}, {"type": "object", "additionalProperties": false, "required": ["candidate_id", "digest"], "properties": {"candidate_id": {"$ref": "urn:research-kb:schema:1.0:definitions#/$defs/step7_candidate_id"}, "digest": {"$ref": "#/$defs/digest"}}}]},
        "payload_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "result_lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["predecessor_task_id", "predecessor_result_digest", "feedback"],
      "properties": {
        "predecessor_task_id": {"$ref": "urn:research-kb:schema:1.0:definitions#/$defs/agent_task_id"},
        "predecessor_result_digest": {"$ref": "#/$defs/digest"},
        "feedback": {"type": "string", "minLength": 1, "maxLength": 4000}
      }
    },
    "refresh_lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["predecessor_task_id", "predecessor_handoff_digest", "refresh_reason"],
      "properties": {
        "predecessor_task_id": {"$ref": "urn:research-kb:schema:1.0:definitions#/$defs/agent_task_id"},
        "predecessor_handoff_digest": {"$ref": "#/$defs/digest"},
        "refresh_reason": {"const": "input_refreshed"}
      }
    },
    "lease": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lease_id", "handoff_digest", "issued_at"],
      "properties": {
        "lease_id": {"$ref": "#/$defs/digest"},
        "handoff_digest": {"$ref": "#/$defs/digest"},
        "issued_at": {"$ref": "urn:research-kb:schema:1.0:definitions#/$defs/timestamp"}
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "reason_code", "feedback", "successor_task_id", "applied_job_state_id", "decided_at"],
      "properties": {
        "action": {"enum": ["revision_requested", "superseded", "rejected", "approved"]},
        "reason_code": {"type": ["string", "null"], "enum": [null, "input_refreshed", "user_rejected", "route_confirmed", "primary_bundle_committed", "review_bundle_committed", "report_accepted", "organization_revision_committed", "screening_revision_committed", "research_synthesis_committed"]},
        "feedback": {"type": ["string", "null"], "maxLength": 4000},
        "successor_task_id": {"anyOf": [{"$ref": "urn:research-kb:schema:1.0:definitions#/$defs/agent_task_id"}, {"type": "null"}]},
        "applied_job_state_id": {"anyOf": [{"$ref": "urn:research-kb:schema:1.0:definitions#/$defs/job_state_id"}, {"type": "null"}]},
        "decided_at": {"$ref": "urn:research-kb:schema:1.0:definitions#/$defs/timestamp"}
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "state_id", "task_id", "workspace_id", "revision", "predecessor", "task_kind", "result_contract", "privacy_registry_version", "executor_id", "execution_scope", "effective_content_classes", "input_basis", "input_basis_digest", "idempotency_key", "lineage", "status", "lease", "staged_result", "decision", "terminal_receipt", "created_at", "updated_at"],
  "properties": {
    "schema_version": {"$ref": "urn:research-kb:schema:1.0:definitions#/$defs/schema_version"},
    "state_id": {"$ref": "urn:research-kb:schema:1.0:definitions#/$defs/agent_task_state_id"},
    "task_id": {"$ref": "urn:research-kb:schema:1.0:definitions#/$defs/agent_task_id"},
    "workspace_id": {"$ref": "urn:research-kb:schema:1.0:definitions#/$defs/workspace_id"},
    "revision": {"type": "integer", "minimum": 1},
    "predecessor": {"anyOf": [{"$ref": "#/$defs/predecessor"}, {"type": "null"}]},
    "task_kind": {"enum": ["document_route_resolution", "primary_semantic_processing", "review_semantic_processing", "knowledge_query_report", "organization_proposal", "question_screening_criteria_proposal", "question_screening_decision_proposal", "research_synthesis_drafting"]},
    "result_contract": {"enum": ["p4a-document-route-decision@1.0", "p4b-primary-semantic-candidate@1.0", "p4c-review-semantic-candidate@1.0", "p5c-knowledge-query-report@1.0", "p7b-organization-proposal@1.0", "p7d-screening-criteria-proposal@1.0", "p7d-screening-decision-proposal@1.0", "p8-research-synthesis-proposal@1.0"]},
    "privacy_registry_version": {"enum": ["p4a-v1", "p4b-v1", "p4c-v1", "p5c-v1", "p7b-v1", "p7d-v1", "p8-v1"]},
    "executor_id": {"enum": ["codex_cli", "claude_code_cli"]},
    "execution_scope": {"const": "cloud_allowed"},
    "effective_content_classes": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {"enum": ["metadata", "parsed_excerpt", "canonical_evidence", "paper_card_content", "operational_context", "research_routing_context", "review_background", "research_synthesis"]}
    },
    "input_basis": {"oneOf": [{"$ref": "#/$defs/route_input_basis"}, {"$ref": "#/$defs/primary_input_basis"}, {"$ref": "#/$defs/review_input_basis"}, {"$ref": "#/$defs/knowledge_query_input_basis"}, {"$ref": "#/$defs/organization_input_basis"}, {"$ref": "#/$defs/screening_criteria_input_basis"}, {"$ref": "#/$defs/screening_decision_input_basis"}, {"$ref": "#/$defs/research_synthesis_input_basis"}]},
    "input_basis_digest": {"$ref": "#/$defs/digest"},
    "idempotency_key": {"type": "string", "minLength": 1, "maxLength": 200},
    "lineage": {"anyOf": [{"$ref": "#/$defs/result_lineage"}, {"$ref": "#/$defs/refresh_lineage"}, {"type": "null"}]},
    "status": {"enum": ["created", "leased", "submitted", "revision_requested", "superseded", "rejected", "approved", "cancelled"]},
    "lease": {"anyOf": [{"$ref": "#/$defs/lease"}, {"type": "null"}]},
