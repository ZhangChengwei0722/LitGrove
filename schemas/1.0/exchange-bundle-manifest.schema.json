{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:research-kb:schema:1.0:exchange-bundle-manifest",
  "$defs": {
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope"],
      "properties": {
        "scope": {"enum": ["paper", "question", "direction", "workspace"]},
        "selector_id": {"type": "string", "minLength": 1, "maxLength": 128}
      },
      "allOf": [
        {"if": {"properties": {"scope": {"const": "workspace"}}, "required": ["scope"]}, "then": {"properties": {"selector_id": false}}, "else": {"required": ["selector_id"]}}
      ]
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "bytes", "record_count", "entry_kind"],
      "properties": {
        "path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[^\\r\\n]+$", "maxLength": 240},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "bytes": {"type": "integer", "minimum": 0},
        "record_count": {"type": "integer", "minimum": 0},
        "entry_kind": {"enum": ["records", "source_index", "source"]}
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "bundle_format", "export_id", "origin_workspace_id", "selection", "contract_versions", "record_count", "record_kind_counts", "source_count", "include_sources", "rights_assertion", "basis_digest", "entries", "created_at"],
  "properties": {
    "schema_version": {"$ref": "urn:research-kb:schema:1.0:definitions#/$defs/schema_version"},
    "bundle_format": {"const": "research-kb-exchange-bundle@1.0"},
    "export_id": {"type": "string", "pattern": "^export_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "origin_workspace_id": {"$ref": "urn:research-kb:schema:1.0:definitions#/$defs/workspace_id"},
    "selection": {"$ref": "#/$defs/selection"},
    "contract_versions": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "record_count": {"type": "integer", "minimum": 1},
    "record_kind_counts": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "integer", "minimum": 1}},
    "source_count": {"type": "integer", "minimum": 0},
    "include_sources": {"type": "boolean"},
    "rights_assertion": {"type": ["string", "null"], "enum": [null, "user_asserts_redistribution_authorized"]},
    "basis_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "entries": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/entry"}},
    "created_at": {"$ref": "urn:research-kb:schema:1.0:definitions#/$defs/timestamp"}
  },
  "allOf": [
    {"if": {"properties": {"include_sources": {"const": true}}, "required": ["include_sources"]}, "then": {"properties": {"rights_assertion": {"const": "user_asserts_redistribution_authorized"}, "source_count": {"minimum": 1}}}, "else": {"properties": {"rights_assertion": {"type": "null"}, "source_count": {"const": 0}}}}
  ]
}
