{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:research-kb:schema:1.0:screening-criteria-bundle",
  "$defs": {
    "approval": {"type": "object", "additionalProperties": false, "required": ["receipt_id", "approved_by", "approved_at", "origin"], "properties": {"receipt_id": {"type": "string", "minLength": 1}, "approved_by": {"const": "user"}, "approved_at": {"$ref": "urn:research-kb:schema:1.0:definitions#/$defs/timestamp"}, "origin": {"const": "user_authored"}}},
    "item": {"type": "object", "additionalProperties": false, "required": ["criterion_id", "text"], "properties": {"criterion_id": {"$ref": "urn:research-kb:schema:1.0:definitions#/$defs/screening_criterion_id"}, "text": {"type": "string", "minLength": 1, "maxLength": 1000}}},
    "criteria": {"type": "object", "additionalProperties": false, "required": ["criteria_id", "question_id", "title", "scope", "inclusion_criteria", "exclusion_criteria", "notes", "status"], "properties": {"criteria_id": {"$ref": "urn:research-kb:schema:1.0:definitions#/$defs/screening_criteria_id"}, "question_id": {"$ref": "urn:research-kb:schema:1.0:definitions#/$defs/question_id"}, "title": {"type": "string", "minLength": 1, "maxLength": 200}, "scope": {"type": "string", "minLength": 1, "maxLength": 4000}, "inclusion_criteria": {"type": "array", "maxItems": 100, "items": {"$ref": "#/$defs/item"}}, "exclusion_criteria": {"type": "array", "maxItems": 100, "items": {"$ref": "#/$defs/item"}}, "notes": {"type": "string", "maxLength": 4000}, "status": {"enum": ["active", "archived"]}}},
    "predecessor": {"oneOf": [{"type": "null"}, {"type": "object", "additionalProperties": false, "required": ["revision_id", "revision_digest"], "properties": {"revision_id": {"$ref": "urn:research-kb:schema:1.0:definitions#/$defs/screening_criteria_revision_id"}, "revision_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}]},
    "revision": {"type": "object", "additionalProperties": false, "required": ["revision_id", "revision_number", "predecessor", "content_digest", "approval", "criteria", "created_at"], "properties": {"revision_id": {"$ref": "urn:research-kb:schema:1.0:definitions#/$defs/screening_criteria_revision_id"}, "revision_number": {"type": "integer", "minimum": 1}, "predecessor": {"$ref": "#/$defs/predecessor"}, "content_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "approval": {"$ref": "#/$defs/approval"}, "criteria": {"$ref": "#/$defs/criteria"}, "created_at": {"$ref": "urn:research-kb:schema:1.0:definitions#/$defs/timestamp"}}}
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "criteria_id", "question_id", "active_revision_id", "revisions", "created_at", "updated_at"],
  "properties": {"schema_version": {"$ref": "urn:research-kb:schema:1.0:definitions#/$defs/schema_version"}, "criteria_id": {"$ref": "urn:research-kb:schema:1.0:definitions#/$defs/screening_criteria_id"}, "question_id": {"$ref": "urn:research-kb:schema:1.0:definitions#/$defs/question_id"}, "active_revision_id": {"$ref": "urn:research-kb:schema:1.0:definitions#/$defs/screening_criteria_revision_id"}, "revisions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/revision"}}, "created_at": {"$ref": "urn:research-kb:schema:1.0:definitions#/$defs/timestamp"}, "updated_at": {"$ref": "urn:research-kb:schema:1.0:definitions#/$defs/timestamp"}, "fixture_origin": {"$ref": "urn:research-kb:schema:1.0:definitions#/$defs/fixture_origin"}}
}
