{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:research-kb:schema:1.0:organization-proposal",
  "$defs": {
    "unit_link": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_kind", "paper_id", "unit_id", "role", "rationale"],
      "properties": {
        "source_kind": {"enum": ["primary", "review"]},
        "paper_id": {"$ref": "urn:research-kb:schema:1.0:definitions#/$defs/paper_id"},
        "review_memory_id": {"$ref": "urn:research-kb:schema:1.0:definitions#/$defs/review_memory_id"},
        "unit_id": {"oneOf": [{"$ref": "urn:research-kb:schema:1.0:definitions#/$defs/unit_id"}, {"$ref": "urn:research-kb:schema:1.0:definitions#/$defs/review_unit_id"}]},
        "role": {"enum": ["factual_example", "background_context", "question_background"]},
        "rationale": {"type": "string", "minLength": 1, "maxLength": 2000}
      },
      "allOf": [
        {"if": {"properties": {"source_kind": {"const": "primary"}}}, "then": {"properties": {"review_memory_id": false, "unit_id": {"$ref": "urn:research-kb:schema:1.0:definitions#/$defs/unit_id"}}}},
        {"if": {"properties": {"source_kind": {"const": "review"}}}, "then": {"required": ["review_memory_id"], "properties": {"unit_id": {"$ref": "urn:research-kb:schema:1.0:definitions#/$defs/review_unit_id"}, "role": {"enum": ["background_context", "question_background"]}}}}
      ]
    },
    "organization_unit_link": {
      "allOf": [
        {"$ref": "#/$defs/unit_link"},
        {"properties": {"role": {"enum": ["factual_example", "background_context"]}}}
      ]
    },
    "question_background_link": {
      "allOf": [
        {"$ref": "#/$defs/unit_link"},
        {"properties": {"role": {"const": "question_background"}}}
      ]
    },
    "direction_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "scope", "status", "unit_links", "gap_notes"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 500},
        "scope": {"type": "string", "minLength": 1, "maxLength": 4000},
        "status": {"enum": ["active", "archived"]},
        "unit_links": {"type": "array", "maxItems": 256, "items": {"$ref": "#/$defs/organization_unit_link"}},
        "gap_notes": {"type": "array", "maxItems": 100, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 2000}}
      }
    },
    "field_map_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "entry_type", "definition", "status", "consensus_level", "direction_refs", "unit_links", "aspect_notes"],
      "properties": {
        "title": {"type": "string", "minLength": 1, "maxLength": 500},
        "entry_type": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,99}$"},
        "definition": {"type": "string", "minLength": 1, "maxLength": 4000},
        "status": {"enum": ["active", "contested_or_unsettled", "archived"]},
        "consensus_level": {"enum": ["single_review", "multiple_reviews", "review_plus_primary_examples", "unsettled"]},
        "direction_refs": {"type": "array", "maxItems": 100, "uniqueItems": true, "items": {"$ref": "urn:research-kb:schema:1.0:definitions#/$defs/direction_id"}},
        "unit_links": {"type": "array", "maxItems": 256, "items": {"$ref": "#/$defs/organization_unit_link"}},
        "aspect_notes": {"type": "array", "maxItems": 100, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 2000}}
      }
    },
    "question_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["question_text", "scope", "mapping_status", "factual_links", "background_links"],
      "properties": {
        "question_text": {"type": "string", "minLength": 1, "maxLength": 2000},
        "scope": {"type": "string", "minLength": 1, "maxLength": 4000},
        "mapping_status": {"enum": ["ai_draft", "ai_checked", "needs_resolution"]},
        "factual_links": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["paper_id", "selected_card_unit_ids", "role_in_question", "relevance_rationale", "boundary_refs"],
            "properties": {
              "paper_id": {"$ref": "urn:research-kb:schema:1.0:definitions#/$defs/paper_id"},
              "selected_card_unit_ids": {"type": "array", "minItems": 1, "maxItems": 100, "uniqueItems": true, "items": {"$ref": "urn:research-kb:schema:1.0:definitions#/$defs/unit_id"}},
              "role_in_question": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,99}$"},
              "relevance_rationale": {"type": "string", "minLength": 1, "maxLength": 2000},
              "boundary_refs": {"type": "array", "maxItems": 100, "uniqueItems": true, "items": {"$ref": "urn:research-kb:schema:1.0:definitions#/$defs/queue_id"}}
            }
          }
        },
        "background_links": {"type": "array", "maxItems": 256, "items": {"$ref": "#/$defs/question_background_link"}}
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "task_id", "input_basis_digest", "target_kind", "target_id", "proposal", "duplicate_notes", "unresolved_conflicts"],
  "properties": {
    "contract_version": {"const": "p7b-organization-proposal@1.0"},
    "task_id": {"$ref": "urn:research-kb:schema:1.0:definitions#/$defs/agent_task_id"},
    "input_basis_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "target_kind": {"enum": ["direction", "field_map_entry", "question"]},
    "target_id": {"type": ["string", "null"], "pattern": "^(direction|fieldmap|question)_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "proposal": {"oneOf": [{"$ref": "#/$defs/direction_payload"}, {"$ref": "#/$defs/field_map_payload"}, {"$ref": "#/$defs/question_payload"}]},
    "duplicate_notes": {"type": "array", "maxItems": 100, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 2000}},
    "unresolved_conflicts": {"type": "array", "maxItems": 100, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 2000}}
  },
  "allOf": [
    {"if": {"properties": {"target_kind": {"const": "direction"}}}, "then": {"properties": {"target_id": {"anyOf": [{"$ref": "urn:research-kb:schema:1.0:definitions#/$defs/direction_id"}, {"type": "null"}]}, "proposal": {"$ref": "#/$defs/direction_payload"}}}},
    {"if": {"properties": {"target_kind": {"const": "field_map_entry"}}}, "then": {"properties": {"target_id": {"anyOf": [{"$ref": "urn:research-kb:schema:1.0:definitions#/$defs/field_map_id"}, {"type": "null"}]}, "proposal": {"$ref": "#/$defs/field_map_payload"}}}},
    {"if": {"properties": {"target_kind": {"const": "question"}}}, "then": {"properties": {"target_id": {"anyOf": [{"$ref": "urn:research-kb:schema:1.0:definitions#/$defs/question_id"}, {"type": "null"}]}, "proposal": {"$ref": "#/$defs/question_payload"}}}}
  ]
}
