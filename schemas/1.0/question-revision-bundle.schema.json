{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:research-kb:schema:1.0:question-revision-bundle",
  "$defs": {
    "approval": {"type": "object", "additionalProperties": false, "required": ["approved_by", "approved_at", "origin"], "properties": {"task_id": {"$ref": "urn:research-kb:schema:1.0:definitions#/$defs/agent_task_id"}, "task_result_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "receipt_id": {"type": "string", "minLength": 1}, "approved_by": {"const": "user"}, "approved_at": {"$ref": "urn:research-kb:schema:1.0:definitions#/$defs/timestamp"}, "origin": {"enum": ["user_authored", "user_approved_agent_proposal"]}}, "allOf": [{"if": {"properties": {"origin": {"const": "user_approved_agent_proposal"}}}, "then": {"required": ["task_id", "task_result_digest"], "properties": {"receipt_id": false}}}, {"if": {"properties": {"origin": {"const": "user_authored"}}}, "then": {"required": ["receipt_id"], "properties": {"task_id": false, "task_result_digest": false}}}]},
    "predecessor": {"oneOf": [{"type": "null"}, {"type": "object", "additionalProperties": false, "required": ["basis_kind", "basis_id", "basis_digest"], "properties": {"basis_kind": {"enum": ["legacy_question_mapping", "question_revision"]}, "basis_id": {"oneOf": [{"$ref": "urn:research-kb:schema:1.0:definitions#/$defs/question_id"}, {"$ref": "urn:research-kb:schema:1.0:definitions#/$defs/question_revision_id"}]}, "basis_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}]},
    "background_link": {"type": "object", "additionalProperties": false, "required": ["question_background_id", "link"], "properties": {"question_background_id": {"$ref": "urn:research-kb:schema:1.0:definitions#/$defs/question_background_id"}, "link": {"$ref": "urn:research-kb:schema:1.0:organization-link"}}},
    "revision": {"type": "object", "additionalProperties": false, "required": ["revision_id", "revision_number", "predecessor", "content_digest", "approval", "question_mapping", "background_links", "created_at"], "properties": {"revision_id": {"$ref": "urn:research-kb:schema:1.0:definitions#/$defs/question_revision_id"}, "revision_number": {"type": "integer", "minimum": 1}, "predecessor": {"$ref": "#/$defs/predecessor"}, "content_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "approval": {"$ref": "#/$defs/approval"}, "question_mapping": {"$ref": "urn:research-kb:schema:1.0:question-mapping"}, "background_links": {"type": "array", "items": {"$ref": "#/$defs/background_link"}}, "created_at": {"$ref": "urn:research-kb:schema:1.0:definitions#/$defs/timestamp"}}}
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "question_id", "active_revision_id", "revisions", "created_at", "updated_at"],
  "properties": {"schema_version": {"$ref": "urn:research-kb:schema:1.0:definitions#/$defs/schema_version"}, "question_id": {"$ref": "urn:research-kb:schema:1.0:definitions#/$defs/question_id"}, "active_revision_id": {"$ref": "urn:research-kb:schema:1.0:definitions#/$defs/question_revision_id"}, "revisions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/revision"}}, "created_at": {"$ref": "urn:research-kb:schema:1.0:definitions#/$defs/timestamp"}, "updated_at": {"$ref": "urn:research-kb:schema:1.0:definitions#/$defs/timestamp"}, "fixture_origin": {"$ref": "urn:research-kb:schema:1.0:definitions#/$defs/fixture_origin"}}
}
