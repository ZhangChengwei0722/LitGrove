{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:research-kb:schema:1.0:primary-semantic-bundle",
  "$defs": {
    "adequacy_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requested_operation", "profile_id", "profile_digest"],
      "properties": {
        "requested_operation": {
          "enum": [
            "basic_paper_card",
            "continuous_text_evidence",
            "figure_table_evidence",
            "formula_layout_analysis",
            "supplementary_analysis"
          ]
        },
        "profile_id": {"$ref": "urn:research-kb:schema:1.0:definitions#/$defs/source_adequacy_id"},
        "profile_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "revision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "revision_id",
        "revision_number",
        "predecessor",
        "approval",
        "input_snapshot",
        "paper_card",
        "evidence",
        "review_queue",
        "created_at"
      ],
      "properties": {
        "revision_id": {"$ref": "urn:research-kb:schema:1.0:definitions#/$defs/primary_revision_id"},
        "revision_number": {"type": "integer", "minimum": 1},
        "predecessor": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["revision_id", "revision_digest"],
              "properties": {
                "revision_id": {"$ref": "urn:research-kb:schema:1.0:definitions#/$defs/primary_revision_id"},
                "revision_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
              }
            }
          ]
        },
        "approval": {
          "type": "object",
          "additionalProperties": false,
          "required": ["task_id", "task_result_digest", "approved_by", "approved_at"],
          "properties": {
            "task_id": {"$ref": "urn:research-kb:schema:1.0:definitions#/$defs/agent_task_id"},
            "task_result_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "approved_by": {"const": "user"},
            "approved_at": {"$ref": "urn:research-kb:schema:1.0:definitions#/$defs/timestamp"}
          }
        },
        "input_snapshot": {
          "type": "object",
          "additionalProperties": false,
          "required": ["source_fingerprint", "parse_run_id", "parse_output_digest", "adequacy_profiles"],
          "properties": {
            "source_fingerprint": {"$ref": "urn:research-kb:schema:1.0:definitions#/$defs/source_fingerprint"},
            "parse_run_id": {"$ref": "urn:research-kb:schema:1.0:definitions#/$defs/event_id"},
            "parse_output_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "adequacy_profiles": {
              "type": "array",
              "minItems": 1,
              "items": {"$ref": "#/$defs/adequacy_snapshot"}
            }
          }
        },
        "paper_card": {"$ref": "urn:research-kb:schema:1.0:paper-card"},
        "evidence": {
          "type": "array",
          "items": {"$ref": "urn:research-kb:schema:1.0:evidence"}
        },
        "review_queue": {
          "type": "array",
          "items": {"$ref": "urn:research-kb:schema:1.0:review-queue"}
        },
        "created_at": {"$ref": "urn:research-kb:schema:1.0:definitions#/$defs/timestamp"}
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "paper_id", "active_revision_id", "revisions", "created_at", "updated_at"],
  "properties": {
    "schema_version": {"$ref": "urn:research-kb:schema:1.0:definitions#/$defs/schema_version"},
    "paper_id": {"$ref": "urn:research-kb:schema:1.0:definitions#/$defs/paper_id"},
    "active_revision_id": {"$ref": "urn:research-kb:schema:1.0:definitions#/$defs/primary_revision_id"},
    "revisions": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/revision"}
    },
    "created_at": {"$ref": "urn:research-kb:schema:1.0:definitions#/$defs/timestamp"},
    "updated_at": {"$ref": "urn:research-kb:schema:1.0:definitions#/$defs/timestamp"},
    "fixture_origin": {"$ref": "urn:research-kb:schema:1.0:definitions#/$defs/fixture_origin"}
  }
}
