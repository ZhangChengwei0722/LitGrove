{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:research-kb:schema:1.0:knowledge-query-report",
  "$defs": {
    "support_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["paper_id", "card_unit_id", "evidence_ids"],
      "properties": {
        "paper_id": {"$ref": "urn:research-kb:schema:1.0:definitions#/$defs/paper_id"},
        "card_unit_id": {"$ref": "urn:research-kb:schema:1.0:definitions#/$defs/unit_id"},
        "evidence_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {"$ref": "urn:research-kb:schema:1.0:definitions#/$defs/evidence_id"}
        }
      }
    },
    "background_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["paper_id", "review_memory_id", "review_unit_id"],
      "properties": {
        "paper_id": {"$ref": "urn:research-kb:schema:1.0:definitions#/$defs/paper_id"},
        "review_memory_id": {"$ref": "urn:research-kb:schema:1.0:definitions#/$defs/review_memory_id"},
        "review_unit_id": {"$ref": "urn:research-kb:schema:1.0:definitions#/$defs/review_unit_id"}
      }
    },
    "answer_block": {
      "type": "object",
      "additionalProperties": false,
      "required": ["block_role", "text", "support_refs", "background_refs", "background_only"],
      "properties": {
        "block_role": {"enum": ["factual", "cross_paper_synthesis", "background", "unresolved"]},
        "text": {"type": "string", "minLength": 1, "maxLength": 20000},
        "support_refs": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/support_ref"}
        },
        "background_refs": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/background_ref"}
        },
        "background_only": {"type": "boolean"}
      },
      "allOf": [
        {
          "if": {"properties": {"block_role": {"const": "factual"}}, "required": ["block_role"]},
          "then": {
            "properties": {
              "support_refs": {"minItems": 1},
              "background_refs": {"maxItems": 0},
              "background_only": {"const": false}
            }
          }
        },
        {
          "if": {"properties": {"block_role": {"const": "cross_paper_synthesis"}}, "required": ["block_role"]},
          "then": {
            "properties": {
              "support_refs": {"minItems": 2},
              "background_refs": {"maxItems": 0},
              "background_only": {"const": false}
            }
          }
        },
        {
          "if": {"properties": {"block_role": {"const": "background"}}, "required": ["block_role"]},
          "then": {
            "properties": {
              "support_refs": {"maxItems": 0},
              "background_refs": {"minItems": 1},
              "background_only": {"const": true}
            }
          }
        },
        {
          "if": {"properties": {"block_role": {"const": "unresolved"}}, "required": ["block_role"]},
          "then": {
            "properties": {
              "support_refs": {"maxItems": 0},
              "background_refs": {"maxItems": 0},
              "background_only": {"const": false}
            }
          }
        }
      ]
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "task_id", "input_basis_digest", "query_type", "answer_blocks", "unresolved_items", "persistence_status", "canonical_scientific_write"],
  "properties": {
    "contract_version": {"const": "p5c-knowledge-query-report@1.0"},
    "task_id": {"$ref": "urn:research-kb:schema:1.0:definitions#/$defs/agent_task_id"},
    "input_basis_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "query_type": {"enum": ["single_paper_explanation", "seven_section_overview", "methods", "selected_paper_comparison", "trend_problem_discussion", "evidence_find"]},
    "answer_blocks": {"type": "array", "maxItems": 128, "items": {"$ref": "#/$defs/answer_block"}},
    "unresolved_items": {"type": "array", "maxItems": 128, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 4000}},
    "persistence_status": {"const": "report_only"},
    "canonical_scientific_write": {"const": false}
  }
}
