{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:research-kb:schema:1.0:evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "evidence_id", "paper_id", "claim", "evidence_type", "quote", "source_page", "locator", "support_scope", "what_it_does_not_support", "source_type", "canonical", "source_fingerprint", "review_status", "automation_status", "created_at", "updated_at"],
  "properties": {
    "schema_version": {"$ref": "urn:research-kb:schema:1.0:definitions#/$defs/schema_version"},
    "evidence_id": {"$ref": "urn:research-kb:schema:1.0:definitions#/$defs/evidence_id"},
    "paper_id": {"$ref": "urn:research-kb:schema:1.0:definitions#/$defs/paper_id"},
    "claim": {"$ref": "urn:research-kb:schema:1.0:definitions#/$defs/non_empty_string"},
    "evidence_type": {"enum": ["reported_result", "method", "control", "limitation", "safety", "efficacy", "mechanism", "other"]},
    "quote": {"$ref": "urn:research-kb:schema:1.0:definitions#/$defs/non_empty_string"},
    "source_page": {"$ref": "urn:research-kb:schema:1.0:definitions#/$defs/source_page"},
    "locator": {"$ref": "urn:research-kb:schema:1.0:definitions#/$defs/non_empty_string"},
    "support_scope": {"$ref": "urn:research-kb:schema:1.0:definitions#/$defs/non_empty_string"},
    "what_it_does_not_support": {"type": "array", "minItems": 1, "items": {"$ref": "urn:research-kb:schema:1.0:definitions#/$defs/non_empty_string"}, "uniqueItems": true},
    "source_type": {"const": "primary"},
    "canonical": {"const": true},
    "source_fingerprint": {"$ref": "urn:research-kb:schema:1.0:definitions#/$defs/source_fingerprint"},
    "review_status": {"$ref": "urn:research-kb:schema:1.0:definitions#/$defs/review_status"},
    "automation_status": {"$ref": "urn:research-kb:schema:1.0:definitions#/$defs/automation_status"},
    "created_at": {"$ref": "urn:research-kb:schema:1.0:definitions#/$defs/timestamp"},
    "updated_at": {"$ref": "urn:research-kb:schema:1.0:definitions#/$defs/timestamp"},
    "fixture_origin": {"$ref": "urn:research-kb:schema:1.0:definitions#/$defs/fixture_origin"}
  }
}
