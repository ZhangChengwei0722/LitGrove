{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:research-kb:schema:1.0:question-mapping",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "question_id", "question_text", "scope", "domain_profile_id", "paper_links", "mapping_status", "created_at", "updated_at"],
  "properties": {
    "schema_version": {"$ref": "urn:research-kb:schema:1.0:definitions#/$defs/schema_version"},
    "question_id": {"$ref": "urn:research-kb:schema:1.0:definitions#/$defs/question_id"},
    "question_text": {"$ref": "urn:research-kb:schema:1.0:definitions#/$defs/non_empty_string"},
    "scope": {"$ref": "urn:research-kb:schema:1.0:definitions#/$defs/non_empty_string"},
    "domain_profile_id": {"$ref": "urn:research-kb:schema:1.0:definitions#/$defs/slug"},
    "paper_links": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["question_link_id", "paper_id", "selected_card_unit_ids", "role_in_question", "relevance_rationale", "evidence_ids", "boundary_refs"],
        "properties": {
          "question_link_id": {"$ref": "urn:research-kb:schema:1.0:definitions#/$defs/qlink_id"},
          "paper_id": {"$ref": "urn:research-kb:schema:1.0:definitions#/$defs/paper_id"},
          "selected_card_unit_ids": {"type": "array", "minItems": 1, "items": {"$ref": "urn:research-kb:schema:1.0:definitions#/$defs/unit_id"}, "uniqueItems": true},
          "role_in_question": {"$ref": "urn:research-kb:schema:1.0:definitions#/$defs/slug"},
          "relevance_rationale": {"$ref": "urn:research-kb:schema:1.0:definitions#/$defs/non_empty_string"},
          "evidence_ids": {"type": "array", "items": {"$ref": "urn:research-kb:schema:1.0:definitions#/$defs/evidence_id"}, "uniqueItems": true},
          "boundary_refs": {"type": "array", "items": {"$ref": "urn:research-kb:schema:1.0:definitions#/$defs/queue_id"}, "uniqueItems": true}
        }
      }
    },
    "mapping_status": {"enum": ["ai_draft", "ai_checked", "needs_resolution"]},
    "created_at": {"$ref": "urn:research-kb:schema:1.0:definitions#/$defs/timestamp"},
    "updated_at": {"$ref": "urn:research-kb:schema:1.0:definitions#/$defs/timestamp"},
    "fixture_origin": {"$ref": "urn:research-kb:schema:1.0:definitions#/$defs/fixture_origin"}
  }
}
