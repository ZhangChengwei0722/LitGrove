{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:research-kb:schema:1.0:screening-decision-bundle",
  "$defs": {
    "approval": {"oneOf": [{"type": "object", "additionalProperties": false, "required": ["receipt_id", "approved_by", "approved_at", "origin"], "properties": {"receipt_id": {"type": "string", "minLength": 1}, "approved_by": {"const": "user"}, "approved_at": {"$ref": "urn:research-kb:schema:1.0:definitions#/$defs/timestamp"}, "origin": {"const": "user_authored"}}}, {"type": "object", "additionalProperties": false, "required": ["approved_by", "approved_at", "origin", "task_id", "task_result_digest"], "properties": {"approved_by": {"const": "user"}, "approved_at": {"$ref": "urn:research-kb:schema:1.0:definitions#/$defs/timestamp"}, "origin": {"const": "user_approved_agent_proposal"}, "task_id": {"$ref": "urn:research-kb:schema:1.0:definitions#/$defs/agent_task_id"}, "task_result_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}]},
    "disposition": {"type": "object", "additionalProperties": false, "required": ["criterion_id", "disposition", "rationale"], "properties": {"criterion_id": {"$ref": "urn:research-kb:schema:1.0:definitions#/$defs/screening_criterion_id"}, "disposition": {"enum": ["met", "not_met", "not_applicable", "uncertain"]}, "rationale": {"type": "string", "minLength": 1, "maxLength": 2000}}},
    "decision": {"type": "object", "additionalProperties": false, "required": ["decision_id", "question_id", "paper_id", "outcome", "criteria_revision_id", "criteria_digest", "criterion_dispositions", "basis_scope", "rationale", "known_limitations"], "properties": {"decision_id": {"$ref": "urn:research-kb:schema:1.0:definitions#/$defs/screening_decision_id"}, "question_id": {"$ref": "urn:research-kb:schema:1.0:definitions#/$defs/question_id"}, "paper_id": {"$ref": "urn:research-kb:schema:1.0:definitions#/$defs/paper_id"}, "outcome": {"enum": ["included", "excluded"]}, "criteria_revision_id": {"$ref": "urn:research-kb:schema:1.0:definitions#/$defs/screening_criteria_revision_id"}, "criteria_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "criterion_dispositions": {"type": "array", "maxItems": 200, "items": {"$ref": "#/$defs/disposition"}}, "basis_scope": {"enum": ["metadata", "available_abstract", "paper_card", "user_full_text_review", "mixed"]}, "rationale": {"type": "string", "minLength": 1, "maxLength": 4000}, "known_limitations": {"type": "array", "maxItems": 50, "items": {"type": "string", "minLength": 1, "maxLength": 1000}}}},
    "predecessor": {"oneOf": [{"type": "null"}, {"type": "object", "additionalProperties": false, "required": ["revision_id", "revision_digest"], "properties": {"revision_id": {"$ref": "urn:research-kb:schema:1.0:definitions#/$defs/screening_decision_revision_id"}, "revision_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}]},
    "revision": {"type": "object", "additionalProperties": false, "required": ["revision_id", "revision_number", "predecessor", "content_digest", "approval", "decision", "created_at"], "properties": {"revision_id": {"$ref": "urn:research-kb:schema:1.0:definitions#/$defs/screening_decision_revision_id"}, "revision_number": {"type": "integer", "minimum": 1}, "predecessor": {"$ref": "#/$defs/predecessor"}, "content_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "approval": {"$ref": "#/$defs/approval"}, "decision": {"$ref": "#/$defs/decision"}, "created_at": {"$ref": "urn:research-kb:schema:1.0:definitions#/$defs/timestamp"}}}
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "decision_id", "question_id", "paper_id", "active_revision_id", "revisions", "created_at", "updated_at"],
  "properties": {"schema_version": {"$ref": "urn:research-kb:schema:1.0:definitions#/$defs/schema_version"}, "decision_id": {"$ref": "urn:research-kb:schema:1.0:definitions#/$defs/screening_decision_id"}, "question_id": {"$ref": "urn:research-kb:schema:1.0:definitions#/$defs/question_id"}, "paper_id": {"$ref": "urn:research-kb:schema:1.0:definitions#/$defs/paper_id"}, "active_revision_id": {"$ref": "urn:research-kb:schema:1.0:definitions#/$defs/screening_decision_revision_id"}, "revisions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/revision"}}, "created_at": {"$ref": "urn:research-kb:schema:1.0:definitions#/$defs/timestamp"}, "updated_at": {"$ref": "urn:research-kb:schema:1.0:definitions#/$defs/timestamp"}, "fixture_origin": {"$ref": "urn:research-kb:schema:1.0:definitions#/$defs/fixture_origin"}}
}
