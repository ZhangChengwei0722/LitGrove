{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:research-kb:schema:1.0:mutation-request",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "operation", "record_kind", "target_record_id", "context", "payload"],
  "properties": {
    "contract_version": {"$ref": "urn:research-kb:schema:1.0:definitions#/$defs/contract_version"},
    "operation": {"enum": ["append", "replace"]},
    "record_kind": {"enum": ["registry-paper", "paper-card", "evidence", "review-queue", "question-mapping"]},
    "target_record_id": {
      "anyOf": [
        {"$ref": "urn:research-kb:schema:1.0:definitions#/$defs/record_id"},
        {"type": "null"}
      ]
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["paper_id"],
      "properties": {
        "paper_id": {
          "anyOf": [
            {"$ref": "urn:research-kb:schema:1.0:definitions#/$defs/paper_id"},
            {"type": "null"}
          ]
        },
        "question_origin": {"enum": ["user_supplied", "user_approved_candidate", "existing_question"]}
      }
    },
    "payload": {"type": "object"},
    "fixture_origin": {"$ref": "urn:research-kb:schema:1.0:definitions#/$defs/fixture_origin"}
  },
  "allOf": [
    {
      "if": {"properties": {"operation": {"const": "append"}}, "required": ["operation"]},
      "then": {"properties": {"target_record_id": {"type": "null"}}}
    },
    {
      "if": {"properties": {"operation": {"const": "replace"}}, "required": ["operation"]},
      "then": {"properties": {"target_record_id": {"$ref": "urn:research-kb:schema:1.0:definitions#/$defs/record_id"}}}
    },
    {
      "if": {"properties": {"record_kind": {"const": "question-mapping"}}, "required": ["record_kind"]},
      "then": {
        "properties": {
          "context": {
            "required": ["paper_id", "question_origin"],
            "properties": {"paper_id": {"type": "null"}}
          }
        }
      },
      "else": {"properties": {"context": {"not": {"required": ["question_origin"]}}}}
    },
    {
      "if": {
        "properties": {
          "record_kind": {"const": "question-mapping"},
          "operation": {"const": "append"}
        },
        "required": ["record_kind", "operation"]
      },
      "then": {
        "properties": {
          "context": {
            "properties": {"question_origin": {"enum": ["user_supplied", "user_approved_candidate"]}}
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "record_kind": {"const": "question-mapping"},
          "operation": {"const": "replace"}
        },
        "required": ["record_kind", "operation"]
      },
      "then": {
        "properties": {
          "context": {"properties": {"question_origin": {"const": "existing_question"}}}
        }
      }
    }
  ]
}
